<resources>
    <!-- Base application theme. -->
    <style name="Theme.Recebimento" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- AlertDialog sempre claro (fundo branco), independente do modo do sistema -->
    <style name="Theme.Recebimento.DialogClaro" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorAccent">@color/m3_primary</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_border</item>
    </style>
</resources>