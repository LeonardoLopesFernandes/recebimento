<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/m3_on_surface"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha uma opção"
        android:textSize="13sp"
        android:textColor="@color/m3_on_surface_variant"
        android:layout_marginBottom="16dp" />

    <!-- Sincronizar % BRLog -->
    <LinearLayout
        android:id="@+id/menuSincronizarBRLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_truck_header"
            android:scaleType="fitCenter"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sincronizar % das Viagens (BRLog)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginStart="14dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Imagens do Recebimento -->
    <LinearLayout
        android:id="@+id/menuImagens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder"
            android:scaleType="fitCenter"
            app:tint="@color/m3_primary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Imagens do Recebimento"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginStart="14dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Viagens a Receber -->
    <LinearLayout
        android:id="@+id/menuReceber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/pendente"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Viagens a Receber"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginStart="14dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Viagens Recebidas -->
    <LinearLayout
        android:id="@+id/menuRecebidas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/recebidas"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Viagens Recebidas"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginStart="14dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Viagens com Anomalia -->
    <LinearLayout
        android:id="@+id/menuAnomalia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/anomalia"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Viagens com Anomalia"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginStart="14dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Viagens com Erro -->
    <LinearLayout
        android:id="@+id/menuErro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_menu_item"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/erro"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Viagens com Erro"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:layout_marginStart="14dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/m3_on_surface_variant"
            android:importantForAccessibility="no" />
    </LinearLayout>

</LinearLayout>
