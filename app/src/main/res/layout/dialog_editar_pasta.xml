<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_border"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTituloEditar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Renomear Pasta"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/m3_on_surface" />

    <TextView
        android:id="@+id/tvSubtituloEditar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informe os novos dados da pasta"
        android:textSize="13sp"
        android:textColor="@color/m3_on_surface_variant"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etViagemEditar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Número da viagem"
        android:inputType="number"
        android:imeOptions="actionNext"
        android:textSize="15sp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_busca" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etDataEditar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Data do recebimento"
        android:textSize="15sp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_busca"
        android:layout_marginTop="12dp"
        android:focusable="false"
        android:clickable="true"
        android:cursorVisible="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancelarEditar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_visualizar_outline"
            app:backgroundTint="@null"
            android:textColor="@color/m3_primary"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSalvarEditar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Salvar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_receber_solid"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
