<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="12dp"
    android:background="#FAFAFA"
    android:layout_marginBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tvGuiaRoll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GUIA: 0501530946"
        android:textSize="12sp"
        android:textColor="#C62828"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BATATA PRINGLES ORIGINAL 104"
            android:textSize="14sp"
            android:textColor="#1A1A1A"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 1.474,07"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E5093A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvQuantidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qtd: 198"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvDepartamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dep: 049"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/tvSap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAP: 4309059"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</LinearLayout>