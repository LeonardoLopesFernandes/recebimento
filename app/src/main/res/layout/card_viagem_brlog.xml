<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutBrlog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_branco_v2"
    android:padding="16dp"
    android:elevation="3dp"
    android:layout_marginTop="12dp"
    android:visibility="gone">

    <!-- Título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RASTREIO BRLOG"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#C62828" />

        <TextView
            android:id="@+id/tvBrlogProgresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_progresso_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="50%"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Motorista"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/tvBrlogMotorista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Saiu p/ entrega"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/tvBrlogSaiuEntrega"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Chegada prevista"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/tvBrlogChegadaPrevista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Dist. restante"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/tvBrlogDistancia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Entrega concluída"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/tvBrlogEntregaConcluida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBrlogAvisoBaJaAutorizado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:background="@drawable/bg_badge_white"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvBrlogBauAutorizado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Baú já autorizado para abertura."
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />
    </LinearLayout>

    <!-- Botão Solicitar Liberação -->
    <TextView
        android:id="@+id/btnSolicitarLiberacao"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_botao_solido_vermelho"
        android:gravity="center"
        android:text="SOLICITAR LIBERAÇÃO"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</LinearLayout>