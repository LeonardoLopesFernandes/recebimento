<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_guia_v2"
    android:padding="16dp"
    android:elevation="2dp"
    android:layout_marginBottom="8dp">

    <!-- Cabeçalho da Guia/Roll -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_ic_guia"
            android:padding="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_document"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNumero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GUIA: 0501530946"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#DE000000"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/tvValorTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 162,78"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#C62828" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvQtdNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notas: 1"
        android:textSize="13sp"
        android:textColor="#9E9E9E"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvNotas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notas: 1 • NF 001612927 (Série 4)"
            android:textSize="13sp"
            android:textColor="#9E9E9E"
            android:lineSpacingMultiplier="1.5"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvVerTudo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VER TUDO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_btn_ver_tudo_v2"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12000000"
        android:layout_marginTop="8dp" />

    <!-- Ações: Ver produtos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/tvExpandir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_inventory_2"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvExpandirText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver produtos (1)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de Produtos (expansível) -->
    <LinearLayout
        android:id="@+id/llProdutos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

</LinearLayout>
