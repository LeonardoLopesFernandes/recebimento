<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_gray"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ============ HEADER (vermelho, estilo Dashboard V2) ============ -->
        <LinearLayout
            android:id="@+id/cvHeader"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:background="#C62828"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp">

            <!-- Caminhão (abre o menu) -->
            <FrameLayout
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_truck_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_truck_header"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Título + subtítulo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recebimento Centralizado"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viagens recebidas"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Engrenagem -->
            <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_gear"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- ============ CONTEÚDO (sobreposto ao header) ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="-30dp"
            android:elevation="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Badges (contadores) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_badges_card_v2"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-25dp"
                android:layout_marginBottom="10dp"
                android:elevation="3dp"
                android:gravity="center">

                <!-- A RECEBER -->
                <LinearLayout
                    android:id="@+id/btnViagensReceber"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipChildren="false">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/ivIconReceber"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/pendente"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvCountReceber"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:minWidth="20dp"
                            android:text="0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_counter"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:layout_gravity="top|end"
                            android:translationX="6dp"
                            android:translationY="-6dp"
                            android:elevation="2dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelReceber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A Receber"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:letterSpacing="0.03"
                        android:maxLines="1" />

                    <View
                        android:id="@+id/viewLineReceber"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_badge_line_orange"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- ANOMALIAS -->
                <LinearLayout
                    android:id="@+id/btnViagensAnomalia"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipChildren="false">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/ivIconAnomalia"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/anomalia"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvCountAnomalia"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:minWidth="20dp"
                            android:text="0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_counter"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:layout_gravity="top|end"
                            android:translationX="6dp"
                            android:translationY="-6dp"
                            android:elevation="2dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelAnomalia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anomalias"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:letterSpacing="0.03"
                        android:maxLines="1" />

                    <View
                        android:id="@+id/viewLineAnomalia"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_badge_line_orange"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- PENDENTES -->
                <LinearLayout
                    android:id="@+id/btnViagensErro"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipChildren="false">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/ivIconErro"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/erro"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvCountErro"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:minWidth="20dp"
                            android:text="0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_counter"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:layout_gravity="top|end"
                            android:translationX="6dp"
                            android:translationY="-6dp"
                            android:elevation="2dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelErro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Erro"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:letterSpacing="0.03"
                        android:maxLines="1" />

                    <View
                        android:id="@+id/viewLineErro"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_badge_line_red"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- RECEBIDAS -->
                <LinearLayout
                    android:id="@+id/btnViagensRecebidas"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipChildren="false">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/ivIconRecebidas"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/recebidas"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvCountRecebidas"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:minWidth="20dp"
                            android:text="0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_counter"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:layout_gravity="top|end"
                            android:translationX="6dp"
                            android:translationY="-6dp"
                            android:elevation="2dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelRecebidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recebidas"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:letterSpacing="0.03"
                        android:maxLines="1" />

                    <View
                        android:id="@+id/viewLineRecebidas"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_badge_line_green"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Barra de Pesquisa -->
            <LinearLayout
                android:id="@+id/layoutBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search_card_v2"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etBuscarViagem"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="Pesquisar Viagem, Placa..."
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#A0AEC0"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="12dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/btnLimparBuscaViagem"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close_btn"
                    android:background="@drawable/bg_botao_busca_limpar"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Filtros / Ordenação -->
            <LinearLayout
                android:id="@+id/layoutFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search_card_v2"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ordenar:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnOrdenarRecente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAIS RECENTES"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_red_v2"
                    app:backgroundTint="@null"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnOrdenarAntigo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAIS ANTIGAS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_inactive_v2"
                    app:backgroundTint="@null"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:textColor="#FFFFFF" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="#E0E0E0"
                    android:layout_marginHorizontal="10dp" />

                <!-- Seletor de visualização (lista/grid) - apenas RECEBIDAS -->
                <LinearLayout
                    android:id="@+id/layoutViewMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btnModoLista"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_view_list"
                        android:scaleType="fitCenter"
                        android:padding="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Visualização em lista" />

                    <ImageView
                        android:id="@+id/btnModoGrid"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_view_grid"
                        android:scaleType="fitCenter"
                        android:padding="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Visualização em grade" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lista de viagens -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecebimentos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="32dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_empty_circle">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_star"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="30dp"
                            android:layout_marginTop="15dp"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_star"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="25dp"
                            android:layout_marginTop="35dp"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_star"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="40dp"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_star"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="20dp"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_empty_clipboard"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_empty_error"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="15dp"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhuma viagem encontrada"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginTop="24dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Puxe para baixo para recarregar"
                        android:textSize="14sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
