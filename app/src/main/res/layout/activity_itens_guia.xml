<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#E5093A">

            <!-- Linha 1: GUIA + GERAR EXCEL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Guia: 0501530946"
                    android:textColor="#E5093A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_white"
                    android:paddingHorizontal="8dp"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btnGerarExcel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="GERAR EXCEL"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_botao_excel_branco"
                    android:textColor="#4CAF50"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Linha 2: TOTAL + GERAR PDF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Total: R$ 162,78"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_botao_excel_preenchido"
                    android:paddingHorizontal="8dp"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/btnGerarPdf"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="GERAR PDF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_botao_card_vermelho_branco"
                    android:textColor="#C8102E"
                    android:paddingHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Barra de Busca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:paddingHorizontal="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_card"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etBuscarItem"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Pesquisar item (nome, SAP ou departamento)"
            android:textSize="14sp"
            android:textColor="@color/text_dark"
            android:textColorHint="#A0AEC0"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnLimparBusca"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_btn"
            android:background="@drawable/bg_botao_busca_limpar"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Lista de Itens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp" />

</LinearLayout>