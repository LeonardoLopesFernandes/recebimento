<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_search_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_folder">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_folder"
            app:tint="@color/m3_primary"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvViagemPasta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viagem 6837376"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface" />

        <TextView
            android:id="@+id/tvDataPasta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="04/08/2026"
            android:textSize="13sp"
            android:textColor="@color/m3_on_surface_variant"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end|center_vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tvQtdFotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/m3_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fotos"
            android:textSize="11sp"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/m3_on_surface_variant"
        android:importantForAccessibility="no" />

</LinearLayout>
